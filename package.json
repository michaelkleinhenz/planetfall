{
  "name": "planetfall-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Infocom and Magnetic Scrolls classics built from their original source, playable in the browser with an AI command interpreter.",
  "type": "module",
  "scripts": {
    "build": "node tools/zil2js/compile.mjs",
    "build:magnetic": "node tools/magnetic/build.mjs",
    "verify": "node tools/zil2js/verify.mjs",
    "test": "node tools/zil2js/verify.mjs && node tests/transcripts.test.mjs",
    "play": "node tools/play.mjs",
    "start": "python3 -m http.server 8000 --directory web"
  },
  "engines": { "node": ">=18" }
}
